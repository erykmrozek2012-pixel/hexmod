  "icon": "assets/hexmod/icon.png",
  "environment": "client",
  "mixins": [
    { "config": "hexmod.client.mixins.json", "environment": "client" }
  ],
  "entrypoints": {
    "client": ["com.hexmod.HexmodClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
